#!/bin/sh
set -u
cd "$(dirname "$0")/.."
log=$(mktemp)
trap 'rm -f "$log"' EXIT

show_log() {
	tail -c "$1" "$log"
	[ -n "$(tail -c 1 "$log")" ] && echo
}

# npm ci leaves a copy of the lockfile it installed. A node_modules from an older
# lockfile, such as one baked into a pylon template, lacks it or differs from it.
stamp=node_modules/.nexus-installed-lock
if ! cmp -s package-lock.json "$stamp"; then
	if npm ci --no-audit --no-fund >"$log" 2>&1 && cp package-lock.json "$stamp"; then
		echo "install: 0"
	else
		code=$?
		show_log 4000
		echo "install: $code"
		exit 75
	fi
fi

for step in check test build; do
	if npm run --silent "$step" >"$log" 2>&1; then
		echo "$step: 0"
	else
		code=$?
		show_log 5000
		echo "$step: $code"
		exit "$code"
	fi
done
