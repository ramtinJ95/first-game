    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "d3-contour": "^4.0.3",
    "d3-delaunay": "^6.0.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
